# Copie para .env (não versionado). Usado por zabbix/criar_comandos.py.
ZABBIX_URL=https://zabbix.example.com
ZABBIX_TOKEN=
# Nome técnico do host do gerador no Zabbix
ZABBIX_HOST=Gerador

# Acesso web ao gateway DSE892 (vira macro do host; a senha como macro secreta)
DSE_HTTP_URL=http://192.0.2.10/
DSE_HTTP_USER=
DSE_HTTP_PW=

# HTTPS do Zabbix com CA própria (opcional). ZABBIX_INSECURE=1 desliga a validação: só para teste.
ZABBIX_CA_FILE=
ZABBIX_INSECURE=0
